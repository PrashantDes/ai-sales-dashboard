# Copy to .streamlit/secrets.toml (git-ignored). Configure only a provider you use.
# Keys and model overrides can also be supplied as environment variables.
# GROQ_API_KEY = "your-groq-key-here"
# GROQ_MODEL = "openai/gpt-oss-20b"
# GEMINI_API_KEY = "your-gemini-key-here"
# GEMINI_MODEL = "your-supported-model"
# ANTHROPIC_API_KEY = "your-anthropic-key-here"
# ANTHROPIC_MODEL = "your-supported-model"
